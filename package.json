{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "predev-all": "php artisan migrate --no-interaction",
        "test:frontend": "node --test tests/Frontend/*.test.js",
        "dev-all": "concurrently --kill-others --names Laravel,Vite --prefix-colors green,cyan \"php artisan serve --host=127.0.0.1 --port=8012\" \"npm run dev\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
